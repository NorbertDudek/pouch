{
  "name": "pouch",
  "version": "0.4.1",
  "private": true,
  "description": "Firefox add-on: save pages with one click and come back to them later.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "lint": "web-ext lint",
    "start": "web-ext run",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=unlisted",
    "sign:listed": "web-ext sign --channel=listed --amo-metadata=amo-metadata.json"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  }
}
